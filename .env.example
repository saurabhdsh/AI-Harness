# --- Option A: OpenAI public API ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Option B: Azure OpenAI (same as test_llm.py on your other Mac) ---
# When both Azure vars are set, Harness prefers Azure over OPENAI_API_KEY.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Deployment name in Azure (your screenshot uses gpt-5-mini)
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
OPENAI_MODEL=gpt-5-mini

# Control plane
# No Docker (default for make dev-local): SQLite file DB
# DATABASE_URL=sqlite+aiosqlite:///./data/harness.db
# With Docker Compose Postgres:
# DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5432/harness
AUTH_DEMO=true
AUTO_CREATE_TABLES=true
HTTP_TIMEOUT_SECONDS=90
LANGGRAPH_AGENT_URL=http://127.0.0.1:8090
