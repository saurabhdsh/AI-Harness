DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5432/harness
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production-harness-jwt-secret
AUTH_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LANGGRAPH_AGENT_URL=http://langgraph-agent:8080
AUTO_CREATE_TABLES=true

# LLM judge — OpenAI public API OR Azure OpenAI (Azure wins if both set)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
OPENAI_MODEL=gpt-5-mini
HTTP_TIMEOUT_SECONDS=90
